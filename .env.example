# Base URL of the prediction backend. The frontend appends /predict to this.
#
# Local development (FastAPI on your machine):
VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id

# Cognito credentials used for automatic sign-in when no active session exists.
VITE_COGNITO_EMAIL=your-email@example.com
VITE_COGNITO_PASSWORD=your-password
