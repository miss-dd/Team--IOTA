# Base URL of the prediction backend. The frontend appends /predict to this.
#
# Local development (FastAPI on your machine):
VITE_API_BASE_URL=http://localhost:8000
#
# Later, once API Gateway is deployed, this becomes something like:
# VITE_API_BASE_URL=https://<api-id>.execute-api.eu-west-1.amazonaws.com/prod
#
# Never put AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, etc.)
# in this file or anywhere in the frontend. The browser must never receive
# AWS credentials — API Gateway + Lambda is what keeps them server-side.
